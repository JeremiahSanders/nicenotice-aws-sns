<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Jds.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" Version="4.0.2.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.23" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="8.10.0"/>
    <PackageReference Include="TUnit" Version="1.12.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\example-console\NiceNotice.Tests.ExampleConsoleApp.csproj"/>
    <ProjectReference Include="..\example-webapi\NiceNotice.Tests.ExampleWebApi.csproj"/>
    <ProjectReference Include="..\unit\NiceNotice.Aws.Sns.Tests.Unit.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Content Update="example.appsettings.local.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
